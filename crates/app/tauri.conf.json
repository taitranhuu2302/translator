{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Translator",
  "version": "0.1.0",
  "identifier": "com.taitran.translator",
  "build": {
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Translator",
        "width": 720,
        "height": 480,
        "visible": false
      },
      {
        "label": "popup",
        "title": "Quick Translate",
        "url": "popup.html",
        "width": 420,
        "height": 220,
        "visible": false,
        "focus": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
