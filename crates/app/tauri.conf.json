{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neris",
  "version": "0.2.0",
  "identifier": "com.taitran.neris",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Neris",
        "width": 960,
        "height": 640,
        "minWidth": 680,
        "minHeight": 460,
        "visible": false,
        "theme": "Dark",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "popup",
        "title": "Quick Translate",
        "url": "popup.html",
        "width": 420,
        "height": 220,
        "transparent": true,
        "visible": false,
        "focus": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "hud",
        "title": "Replace",
        "url": "hud.html",
        "width": 260,
        "height": 52,
        "transparent": true,
        "visible": false,
        "focus": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/taitranhuu2302/translator/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzREVENDY2RTcxOUY5QjAKUldTdytSbm5adFRlTStibm1tM0FTT2hPU2VXWGltakhRZDh1UmlOOS9nY2JIa2FkRm0yY0JSUVoK"
    }
  }
}
